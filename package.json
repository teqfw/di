{
  "name": "@teqfw/di",
  "version": "2.7.0",
  "description": "Deterministic token-based runtime linker for native JavaScript ES modules.",
  "keywords": [
    "teqfw",
    "javascript",
    "esm",
    "es modules",
    "runtime linking",
    "dependency injection",
    "module tokens",
    "namespace",
    "late binding"
  ],
  "homepage": "https://github.com/teqfw/di#readme",
  "bugs": {
    "url": "https://github.com/teqfw/di/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Alex Gusev",
    "email": "alex@flancer64.com",
    "url": "https://github.com/flancer64"
  },
  "files": [
    "ai/",
    "skills/",
    "dist/",
    "src/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "types.d.ts"
  ],
  "types": "types.d.ts",
  "exports": {
    ".": {
      "browser": {
        "import": "./dist/esm.js",
        "require": "./dist/umd.js"
      },
      "import": "./src/Container.mjs",
      "default": "./src/Container.mjs"
    },
    "./node/registry/namespace": "./src/Node/Registry/Namespace.mjs",
    "./node/registry/package": "./src/Node/Registry/Package.mjs",
    "./src/Config/NamespaceRegistry.mjs": "./src/Config/NamespaceRegistry.mjs"
  },
  "type": "module",
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "TeqFw_Di_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teqfw/di.git"
  },
  "scripts": {
    "rollup": "rollup -c",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "find test/unit -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test:integration": "find test/integration -name '*.test.mjs' -print0 | xargs -0 node --test"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.59.0"
  },
  "engines": {
    "node": ">=20"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/teqfw"
  }
}
