{
  "name": "@teqfw/di",
  "version": "2.11.0",
  "description": "Deterministic dependency-resolution container for native JavaScript ES modules.",
  "keywords": [
    "teqfw",
    "javascript",
    "esm",
    "es modules",
    "runtime linking",
    "dependency injection",
    "dependency resolution",
    "dependency identifiers",
    "namespace",
    "late binding"
  ],
  "homepage": "https://github.com/teqfw/di#readme",
  "bugs": {
    "url": "https://github.com/teqfw/di/issues"
  },
  "license": "Apache-2.0",
  "authors": [
    {
      "name": "Alex Gusev",
      "email": "alex@flancer64.com",
      "url": "https://github.com/flancer64"
    }
  ],
  "files": [
    "skills/",
    "dist/",
    "src/",
    "CHANGELOG.md",
    "jsconfig.json",
    "LICENSE",
    "README.md",
    "types.d.ts"
  ],
  "types": "types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "browser": {
        "import": "./dist/esm.js",
        "require": "./dist/umd.js"
      },
      "import": "./src/Container.mjs",
      "default": "./src/Container.mjs"
    },
    "./node/registry/namespace": "./src/Node/Registry/Namespace.mjs",
    "./node/registry/package": "./src/Node/Registry/Package.mjs",
    "./src/Config/NamespaceRegistry.mjs": "./src/Config/NamespaceRegistry.mjs"
  },
  "type": "module",
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "TeqFw_Di_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      }
    },
    "platform": {
      "unitTests": {
        "exclusions": [
          {
            "path": "src/Config/NamespaceRegistry.mjs",
            "reason": "Deprecated compatibility re-export with no component behavior."
          }
        ]
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/teqfw/di.git"
  },
  "scripts": {
    "rollup": "rollup -c",
    "test": "npm run test:unit && npm run test:integration && npm run test:package",
    "test:unit": "find test/unit -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test:integration": "find test/integration -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test:package": "find test/package -name '*.test.mjs' -print0 | xargs -0 node --test",
    "typecheck": "tsc -p jsconfig.json",
    "lint:md": "markdownlint-cli2 \"skills/**/*.md\" \"*.md\""
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^20.19.43",
    "markdownlint-cli2": "^0.23.2",
    "rollup": "^4.59.0",
    "typescript": "^5.9.3",
    "typescript-language-server": "^5.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/teqfw"
  }
}
